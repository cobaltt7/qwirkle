{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"importHelpers": false,
		"jsx": "preserve",
		"lib": ["esnext", "dom"],
		"module": "esnext",
		"moduleResolution": "node",
		"target": "esnext",
		"types": ["vite/client"]
	},
	"exclude": ["server/**/*", "dist", "vite.config.ts.*"]
}
